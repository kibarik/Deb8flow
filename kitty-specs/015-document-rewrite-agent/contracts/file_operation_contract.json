{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deb8flow.dev/contracts/file_operation_contract.json",
  "title": "File Operation Contract",
  "description": "Contract for file copying, metadata preservation, and naming operations",
  "type": "object",
  "definitions": {
    "CopyRequest": {
      "type": "object",
      "description": "Request to copy original document to run-id directory",
      "properties": {
        "source_path": {
          "type": "string",
          "description": "Absolute path to source document",
          "minLength": 1
        },
        "destination_directory": {
          "type": "string",
          "description": "Absolute path to destination (run-id) directory",
          "minLength": 1
        },
        "preserve_filename": {
          "type": "boolean",
          "description": "Whether to preserve original filename",
          "default": true
        },
        "preserve_metadata": {
          "type": "boolean",
          "description": "Whether to preserve file metadata",
          "default": true
        }
      },
      "required": ["source_path", "destination_directory"]
    },
    "CopyResult": {
      "type": "object",
      "description": "Result from file copy operation",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether copy succeeded"
        },
        "error_message": {
          "type": ["string", "null"],
          "description": "Error message if success=false"
        },
        "copied_file_path": {
          "type": "string",
          "description": "Absolute path to copied file"
        },
        "metadata": {
          "type": ["object", "null"],
          "description": "Preserved file metadata",
          "properties": {
            "original_path": {
              "type": "string",
              "description": "Original file path"
            },
            "copied_path": {
              "type": "string",
              "description": "Copied file path"
            },
            "filename": {
              "type": "string",
              "description": "Filename"
            },
            "extension": {
              "type": "string",
              "description": "File extension (with dot, e.g., '.docx')"
            },
            "size_bytes": {
              "type": "integer",
              "description": "File size in bytes",
              "minimum": 0
            },
            "created_at": {
              "type": ["string", "null"],
              "description": "Creation timestamp (ISO 8601)"
            },
            "modified_at": {
              "type": ["string", "null"],
              "description": "Modification timestamp (ISO 8601)"
            },
            "author": {
              "type": ["string", "null"],
              "description": "Document author (if available)"
            },
            "copied_at": {
              "type": "string",
              "description": "Copy timestamp (ISO 8601)"
            }
          },
          "required": ["original_path", "copied_path", "filename", "extension", "size_bytes", "copied_at"]
        }
      },
      "required": ["success", "copied_file_path"]
    },
    "GenerateOutputFilenameRequest": {
      "type": "object",
      "description": "Request to generate output filename for rewritten document",
      "properties": {
        "original_filename": {
          "type": "string",
          "description": "Original filename (e.g., 'prd.docx')",
          "minLength": 1
        },
        "timestamp": {
          "type": ["string", "null"],
          "description": "Timestamp to use (ISO 8601 format or null for current time)"
        }
      },
      "required": ["original_filename"]
    },
    "GenerateOutputFilenameResult": {
      "type": "object",
      "description": "Result from filename generation",
      "properties": {
        "filename": {
          "type": "string",
          "description": "Generated filename (e.g., 'prd_20260217_123456.docx')"
        },
        "original_name": {
          "type": "string",
          "description": "Original name without extension (e.g., 'prd')"
        },
        "extension": {
          "type": "string",
          "description": "File extension (with dot, e.g., '.docx')"
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp used in filename (YYYYMMDD_HHMMSS format)"
        }
      },
      "required": ["filename", "original_name", "extension", "timestamp"]
    },
    "SaveMetadataRequest": {
      "type": "object",
      "description": "Request to save metadata to JSON file",
      "properties": {
        "metadata": {
          "type": "object",
          "description": "Metadata to save"
        },
        "output_directory": {
          "type": "string",
          "description": "Directory to save metadata file in",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "description": "Metadata filename",
          "default": "file_metadata.json"
        }
      },
      "required": ["metadata", "output_directory"]
    },
    "SaveMetadataResult": {
      "type": "object",
      "description": "Result from metadata save operation",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether save succeeded"
        },
        "error_message": {
          "type": ["string", "null"],
          "description": "Error message if success=false"
        },
        "saved_path": {
          "type": "string",
          "description": "Absolute path to saved metadata file"
        }
      },
      "required": ["success", "saved_path"]
    }
  },
  "naming_convention": {
    "pattern": "^(.+)_(\\d{8})_(\\d{6})\\.(.+)$",
    "description": "Pattern: {original_name}_{YYYYMMDD}_{HHMMSS}.{extension}",
    "examples": [
      "prd_20260217_123456.docx",
      "document_20260217_235959.md",
      "notes_20260217_000001.txt"
    ],
    "timezone": "UTC",
    "timestamp_format": "YYYYMMDD_HHMMSS"
  },
  "metadata_storage": {
    "filename": "file_metadata.json",
    "location": "run-id directory",
    "structure": {
      "original_file": "path to original document",
      "copied_file": "path to copied document",
      "rewritten_file": "path to rewritten document",
      "preserved_metadata": {
        "author": "document author (if available)",
        "created": "creation timestamp (ISO 8601)",
        "modified": "modification timestamp (ISO 8601)",
        "size_bytes": "file size",
        "doc_properties": "document-specific properties (for .docx)"
      },
      "rewrite_metadata": {
        "started_at": "rewrite start timestamp (ISO 8601)",
        "completed_at": "rewrite completion timestamp (ISO 8601)",
        "duration_seconds": "rewrite duration",
        "llm_model": "model used for rewriting",
        "recommendations_count": "number of recommendations",
        "recommendations_applied": "number successfully applied"
      }
    }
  },
  "error_codes": {
    "SOURCE_NOT_FOUND": {
      "code": "FILE_ERR_001",
      "message": "Source file not found",
      "recoverable": false
    },
    "DESTINATION_NOT_WRITABLE": {
      "code": "FILE_ERR_002",
      "message": "Destination directory not writable",
      "recoverable": false
    },
    "COPY_FAILED": {
      "code": "FILE_ERR_003",
      "message": "File copy operation failed",
      "recoverable": false
    },
    "METADATA_EXTRACTION_FAILED": {
      "code": "FILE_ERR_004",
      "message": "Failed to extract file metadata",
      "recoverable": true,
      "note": "Copy continues without metadata"
    },
    "METADATA_SAVE_FAILED": {
      "code": "FILE_ERR_005",
      "message": "Failed to save metadata JSON",
      "recoverable": true,
      "note": "Rewrite continues without metadata file"
    },
    "INVALID_FILENAME": {
      "code": "FILE_ERR_006",
      "message": "Invalid filename format",
      "recoverable": false
    }
  }
}
