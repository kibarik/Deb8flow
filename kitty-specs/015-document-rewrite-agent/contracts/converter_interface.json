{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deb8flow.dev/contracts/converter_interface.json",
  "title": "Format Converter Interface",
  "description": "Interface contract for format converters (to/from markdown)",
  "type": "object",
  "definitions": {
    "ConverterCapabilities": {
      "type": "object",
      "description": "Capabilities of a format converter",
      "properties": {
        "format": {
          "type": "string",
          "description": "Format identifier (docx, md, txt, rtf)"
        },
        "supports_bidirectional": {
          "type": "boolean",
          "description": "Whether format supports both to_markdown and from_markdown"
        },
        "supports_metadata_preservation": {
          "type": "boolean",
          "description": "Whether format can preserve metadata"
        },
        "preserves_formatting": {
          "type": "boolean",
          "description": "Whether formatting (bold, italics, etc.) is preserved"
        }
      },
      "required": ["format", "supports_bidirectional"]
    },
    "ToMarkdownRequest": {
      "type": "object",
      "description": "Request to convert document to markdown",
      "properties": {
        "source_path": {
          "type": "string",
          "description": "Absolute path to source file",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": ["docx", "md", "txt", "rtf"],
          "description": "Source file format"
        },
        "extract_metadata": {
          "type": "boolean",
          "description": "Whether to extract file metadata",
          "default": true
        }
      },
      "required": ["source_path", "format"]
    },
    "ToMarkdownResult": {
      "type": "object",
      "description": "Result from to_markdown conversion",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether conversion succeeded"
        },
        "error_message": {
          "type": ["string", "null"],
          "description": "Error message if success=false"
        },
        "markdown_content": {
          "type": ["string", "null"],
          "description": "Converted markdown content"
        },
        "metadata": {
          "type": ["object", "null"],
          "description": "Extracted file metadata",
          "properties": {
            "author": {
              "type": ["string", "null"]
            },
            "created_at": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "modified_at": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "title": {
              "type": ["string", "null"]
            },
            "size_bytes": {
              "type": "integer"
            }
          }
        },
        "formatting_warnings": {
          "type": "array",
          "description": "List of formatting issues during conversion",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": ["success"]
    },
    "FromMarkdownRequest": {
      "type": "object",
      "description": "Request to convert markdown to target format",
      "properties": {
        "markdown_content": {
          "type": "string",
          "description": "Markdown content to convert",
          "minLength": 1
        },
        "target_format": {
          "type": "string",
          "enum": ["docx", "md", "txt", "rtf"],
          "description": "Target format"
        },
        "output_path": {
          "type": "string",
          "description": "Absolute path for output file",
          "minLength": 1
        },
        "preserve_metadata": {
          "type": "boolean",
          "description": "Whether to preserve metadata (if available)",
          "default": true
        },
        "metadata_to_preserve": {
          "type": ["object", "null"],
          "description": "Metadata to preserve in output",
          "properties": {
            "author": {
              "type": ["string", "null"]
            },
            "title": {
              "type": ["string", "null"]
            }
          }
        }
      },
      "required": ["markdown_content", "target_format", "output_path"]
    },
    "FromMarkdownResult": {
      "type": "object",
      "description": "Result from from_markdown conversion",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether conversion succeeded"
        },
        "error_message": {
          "type": ["string", "null"],
          "description": "Error message if success=false"
        },
        "output_path": {
          "type": "string",
          "description": "Path to written output file"
        },
        "bytes_written": {
          "type": "integer",
          "description": "Number of bytes written",
          "minimum": 0
        },
        "formatting_warnings": {
          "type": "array",
          "description": "List of formatting issues during conversion",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": ["success", "output_path"]
    }
  },
  "converter_registries": {
    "docx": {
      "class": "DocxConverter",
      "capabilities": {
        "format": "docx",
        "supports_bidirectional": true,
        "supports_metadata_preservation": true,
        "preserves_formatting": true
      },
      "dependencies": ["python-docx", "mammoth"],
      "notes": "Uses mammoth for to_markdown, python-docx for from_markdown"
    },
    "md": {
      "class": "MarkdownConverter",
      "capabilities": {
        "format": "md",
        "supports_bidirectional": true,
        "supports_metadata_preservation": false,
        "preserves_formatting": true
      },
      "dependencies": [],
      "notes": "Pass-through converter, minimal processing"
    },
    "txt": {
      "class": "TextConverter",
      "capabilities": {
        "format": "txt",
        "supports_bidirectional": true,
        "supports_metadata_preservation": false,
        "preserves_formatting": false
      },
      "dependencies": [],
      "notes": "Simple UTF-8 text encoding/decoding"
    },
    "rtf": {
      "class": "RtfConverter",
      "capabilities": {
        "format": "rtf",
        "supports_bidirectional": false,
        "supports_metadata_preservation": false,
        "preserves_formatting": false
      },
      "dependencies": ["pyth"],
      "notes": "Limited support, conversion loss expected"
    }
  }
}
