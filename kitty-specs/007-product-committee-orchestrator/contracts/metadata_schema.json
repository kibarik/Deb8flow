{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deb8flow.dev/schemas/metadata.json",
  "title": "CommitteeRunMetadata",
  "description": "Administrative metadata about a Product Committee Orchestrator run",
  "type": "object",
  "required": [
    "run_id",
    "prd_path",
    "question",
    "model",
    "start_time",
    "end_time",
    "room_statuses",
    "roles_dir"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this run (timestamp-based or user-provided)"
    },
    "prd_path": {
      "type": "string",
      "description": "Absolute or relative path to the PRD document"
    },
    "question": {
      "type": "string",
      "description": "The committee question posed to all rooms"
    },
    "model": {
      "type": "string",
      "description": "LLM model used for debates (if specified)"
    },
    "start_time": {
      "type": "string",
      "description": "ISO 8601 timestamp of orchestrator start",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "description": "ISO 8601 timestamp of orchestrator completion",
      "format": "date-time"
    },
    "room_statuses": {
      "type": "object",
      "description": "Status of each debate room",
      "required": ["tpm_cpo", "tpm_cfo", "tpm_cto", "tpm_bdm"],
      "properties": {
        "tpm_cpo": {
          "type": "string",
          "enum": ["success", "failed", "skipped_missing_prompt"],
          "description": "Status of TPM vs CPO room"
        },
        "tpm_cfo": {
          "type": "string",
          "enum": ["success", "failed", "skipped_missing_prompt"],
          "description": "Status of TPM vs CFO room"
        },
        "tpm_cto": {
          "type": "string",
          "enum": ["success", "failed", "skipped_missing_prompt"],
          "description": "Status of TPM vs CTO room"
        },
        "tpm_bdm": {
          "type": "string",
          "enum": ["success", "failed", "skipped_missing_prompt"],
          "description": "Status of TPM vs BDM room"
        }
      }
    },
    "roles_dir": {
      "type": "string",
      "description": "Directory path where role prompt files were loaded from"
    },
    "output_dir": {
      "type": "string",
      "description": "Directory path where run artifacts were saved"
    },
    "max_retries": {
      "type": "integer",
      "description": "Maximum retry attempts per room (default: 2)",
      "default": 2
    },
    "warning_flags": {
      "type": "object",
      "description": "Warning flags set during the run",
      "properties": {
        "prd_too_short": {
          "type": "boolean",
          "description": "True if PRD was < 100 characters",
          "default": false
        },
        "question_too_short": {
          "type": "boolean",
          "description": "True if question was < 5 characters",
          "default": false
        },
        "some_rooms_failed": {
          "type": "boolean",
          "description": "True if any room failed or was skipped",
          "default": false
        }
      }
    },
    "errors": {
      "type": "array",
      "description": "List of non-fatal errors encountered during the run",
      "items": {
        "type": "object",
        "properties": {
          "room": {
            "type": "string",
            "description": "Room where error occurred (or 'orchestrator' for general errors)"
          },
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "timestamp": {
            "type": "string",
            "description": "ISO 8601 timestamp of error",
            "format": "date-time"
          }
        }
      }
    },
    "version": {
      "type": "string",
      "description": "Product committee orchestrator version"
    }
  }
}
