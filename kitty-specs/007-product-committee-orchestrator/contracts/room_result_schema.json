{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deb8flow.dev/schemas/room_result.json",
  "title": "DebateRoomResult",
  "description": "Structured output from a single debate room (TPM vs role) in the Product Committee Orchestrator",
  "type": "object",
  "required": [
    "room_id",
    "status",
    "timestamp",
    "tpm_position",
    "opponent_position",
    "judge_verdict",
    "takeaways"
  ],
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Room identifier (e.g., 'TPM_vs_CPO', 'TPM_vs_CFO')",
      "pattern": "^TPM_vs_[A-Z]+$"
    },
    "status": {
      "type": "string",
      "description": "Execution status of the room",
      "enum": ["success", "failed", "skipped_missing_prompt"]
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of room completion",
      "format": "date-time"
    },
    "tpm_position": {
      "type": "string",
      "description": "Summary of TPM's position in this debate"
    },
    "opponent_position": {
      "type": "string",
      "description": "Summary of opponent's position in this debate"
    },
    "judge_verdict": {
      "type": "object",
      "description": "Judge's assessment of the debate",
      "required": ["winner", "explanation"],
      "properties": {
        "winner": {
          "type": "string",
          "description": "Which side prevailed (TPM or opponent name)"
        },
        "explanation": {
          "type": "string",
          "description": "Judge's reasoning for the verdict"
        },
        "scores": {
          "type": "object",
          "description": "Optional score breakdown if available",
          "properties": {
            "tpm_score": {
              "type": "number",
              "description": "TPM's score if applicable"
            },
            "opponent_score": {
              "type": "number",
              "description": "Opponent's score if applicable"
            }
          }
        }
      }
    },
    "takeaways": {
      "type": "array",
      "description": "3-5 key insights or recommendations for TPM from this room",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "description": "A single takeaway or recommendation"
      }
    },
    "error": {
      "type": "string",
      "description": "Error message if status is 'failed' (optional)"
    }
  }
}
